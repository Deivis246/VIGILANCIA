# PostgreSQL database used by the API.
# Example: postgresql://vigilancia:change-this-password@127.0.0.1:5432/vigilancia
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/vigilancia

# Required by the API at startup and by the outbreak prediction module.
# Create it in Google AI Studio. Never commit the real key.
GOOGLE_GEMINI_API_KEY=replace-with-your-google-gemini-key

# Local API and frontend settings.
API_ORIGIN=http://127.0.0.1:8080
PORT=8080
BASE_PATH=/
